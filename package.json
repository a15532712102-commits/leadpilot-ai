{
  "name": "leadpilot-ai-mobile",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check:worker": "node --check backend/src/worker.js",
    "dev:worker": "wrangler dev --config backend/wrangler.jsonc",
    "deploy:worker": "wrangler deploy --config backend/wrangler.jsonc",
    "test:browser": "playwright test",
    "check": "node --check app.js && node --check core.js && node --check backend/src/worker.js",
    "build:worker": "wrangler deploy --dry-run --config backend/wrangler.jsonc"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "jsdom": "^30.1.3",
    "wrangler": "^4.0.0"
  }
}
